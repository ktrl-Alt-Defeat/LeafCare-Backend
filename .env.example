# LeafCare Backend — environment template
# Copy to .env and fill in the secrets. Never commit .env itself.

# --- Server ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

# Comma-separated origins allowed by CORS. Use * for any (development only).
CORS_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the app. Must be set correctly in
# production or rate limiting will bucket every client together.
TRUST_PROXY=0

# --- Database ----------------------------------------------------------------
# DATABASE_URL: pooled connection (Supabase transaction pooler, port 6543).
# DIRECT_URL:   direct connection (port 5432), required by prisma migrate/db pull.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Rate limiting -----------------------------------------------------------
# All limiters share one window. Set RATE_LIMIT_ENABLED=false in tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_UPLOAD_MAX=5

# --- External AI inference service -------------------------------------------
# The disease-prediction model runs as an independent deployment. Leave unset
# until it exists: /ready and /api/v1/ai/health then report `not_configured`
# instead of inventing model details.
# The deployed classifier is EfficientNetV2-S over the 38 PlantVillage classes.
# It exposes GET /health and POST /predict, where /predict takes multipart field
# `image` and returns `predicted_class`, `confidence` and `top_5_predictions`.
AI_SERVICE_URL=https://efficentnet-plant-disease-detection.onrender.com
# Generous on purpose: the Render free tier cold-starts in roughly 60 seconds
# after idling, and the previous 30s default timed out on that first request.
AI_SERVICE_TIMEOUT_MS=90000

# --- Pl@ntNet API Configuration ----------------------------------------------
# PLANTNET_API_KEY: Obtained from Pl@ntNet. Never commit real secrets.
PLANTNET_API_KEY=YOUR_REAL_KEY
PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all
PLANTNET_MIN_CONFIDENCE=0.50
PLANTNET_TIMEOUT_MS=20000
