# =============================================================================
# LeafCare backend — environment
# =============================================================================
# Copy to .env for local work. On Render, set these in the service's
# Environment tab (or let render.yaml prompt for the ones marked sync: false).
#
# Only three values have no sensible default and must be supplied:
#   DATABASE_URL, DIRECT_URL, INFERENCE_API_KEY
# Everything else either has a default or degrades cleanly when unset.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=debug

# Number of reverse proxies in front of the app. Rate limiting keys on client
# IP, so behind Render's load balancer this must be 1 — at 0 every request
# appears to come from the proxy and all users share one bucket.
TRUST_PROXY=0

# --- CORS ----------------------------------------------------------------
# Comma-separated allowed origins. The Next.js app calls this API from its own
# server-side route handlers, so no browser Origin is involved in normal use;
# these cover direct browser calls during development. In production, list the
# deployed frontend origin.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://localhost:3000

# --- Database ------------------------------------------------------------
# REQUIRED. Supabase pooled connection (port 6543) for the app; direct
# connection (5432) for migrations, which pgbouncer cannot serve.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Inference host ----------------------------------------------------------
# The FastAPI service holding the leaf detector and the disease classifier.
# It runs on a GPU workstation and is published through a tunnel, so this is a
# public HTTPS URL pointing at a machine that is not always awake.
#
# Optional: unset means leaf localization is skipped and disease detection
# reports itself unconfigured. The API still serves everything else.
INFERENCE_SERVICE_URL=https://inference.example.com

# REQUIRED when INFERENCE_SERVICE_URL is set. Must equal API_KEY in
# leafcare-inference/.env — the host answers 401 otherwise.
INFERENCE_API_KEY=

# Default deadline for an inference call.
INFERENCE_TIMEOUT_MS=45000
# Tighter: the live viewfinder polls detection, and a frame the user has already
# moved past is worthless, so giving up early beats waiting.
INFERENCE_DETECT_TIMEOUT_MS=20000
# Generous: the farmer is watching a progress animation, and the first request
# after the host wakes pays for weight residency.
INFERENCE_CLASSIFY_TIMEOUT_MS=60000
# Health probes must not hang a dashboard.
INFERENCE_HEALTH_TIMEOUT_MS=8000

# --- Leaf detector request parameters ---------------------------------------
# Sent with each detection request. Where the detector lives is
# INFERENCE_SERVICE_URL above; these are only its knobs.
#
# Leaf detection is advisory by construction: finding nothing means the full
# frame is classified, never that the scan stops. There is no gate flag.
YOLO_MIN_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=640

# --- Rate limiting -----------------------------------------------------------
# All windows share RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=20
# Full scans. The most expensive call in the system.
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_UPLOAD_MAX=5
# The live viewfinder detector, polled several times a second while a farmer
# frames a leaf. The AI ceiling of ten a minute would cut guidance off after
# seven seconds of aiming, so this gets its own much higher limit.
RATE_LIMIT_VISION_MAX=300

# --- Admin / seller write endpoints -----------------------------------------
# Shared secret guarding the knowledge-base and marketplace write endpoints.
# Not authentication: it carries no identity. Optional — when unset those
# endpoints fail closed with 403 rather than opening up. Minimum 16 characters.
LEAFCARE_ADMIN_KEY=

# --- ElevenLabs voice (optional) ---------------------------------------------
# Unset means the voice endpoints answer 503 with a clear message; the rest of
# the API is unaffected.
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_API_URL=https://api.elevenlabs.io/v1
# Flash is the default: lowest latency, cheapest per character, and it accepts
# language_code, which pins pronunciation instead of letting the model guess.
# Use eleven_v3 for Telugu, Kannada and Malayalam, which v2.5 does not cover.
ELEVEN_LABS_TTS_MODEL=eleven_flash_v2_5
ELEVEN_LABS_STT_MODEL=scribe_v1
# Premade "Sarah". Verified to synthesize on the free tier — some premade voices
# are classified as library voices and answer 402 for free accounts.
ELEVEN_LABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVEN_LABS_TIMEOUT_MS=30000
# Synthesis is billed per character; this is the server-side backstop against an
# accidental request carrying a whole article.
ELEVEN_LABS_MAX_CHARS=2500

# =============================================================================
# Removed — delete these if they are still set anywhere
# =============================================================================
# PLANTNET_API_KEY, PLANTNET_API_URL, PLANTNET_MIN_CONFIDENCE,
# PLANTNET_TIMEOUT_MS
#     Pl@ntNet is no longer in the pipeline. The classifier's own label says
#     which crop a photo shows, and the novelty check on the inference host
#     decides whether to believe it.
#
# AI_SERVICE_URL, AI_SERVICE_TIMEOUT_MS, YOLO_SERVICE_URL,
# YOLO_SERVICE_TIMEOUT_MS
#     Both models now live in one process behind INFERENCE_SERVICE_URL.
#
# YOLO_CROP_PADDING
#     Cropping happens on the inference host now; it is ROI_PADDING there.
#
# YOLO_GATE_ENABLED
#     Leaf detection can no longer refuse a scan, so there is nothing to gate.
