# LeafCare Backend — environment template
# Copy to .env and fill in the secrets. Never commit .env itself.

# --- Server ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

# Comma-separated origins allowed by CORS. Use * for any (development only).
CORS_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the app. Must be set correctly in
# production or rate limiting will bucket every client together.
TRUST_PROXY=0

# --- Database ----------------------------------------------------------------
# DATABASE_URL: pooled connection (Supabase transaction pooler, port 6543).
# DIRECT_URL:   direct connection (port 5432), required by prisma migrate/db pull.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Rate limiting -----------------------------------------------------------
# All limiters share one window. Set RATE_LIMIT_ENABLED=false in tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_UPLOAD_MAX=5

# --- Admin / seller write guard ----------------------------------------------
# Shared secret protecting the admin (knowledge base) and seller (marketplace)
# write endpoints. This is NOT authentication: it carries no user identity and
# no per-user permissions, it only proves the caller knows the secret.
#
# It must only ever be sent server-side — the frontend attaches it in its own
# route handlers, never in the browser. If it reaches the client the guard is
# worthless. Replace with a real auth module before production.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave unset to disable writes entirely: the endpoints then fail closed (403).
LEAFCARE_ADMIN_KEY=

# --- External AI inference service -------------------------------------------
# The disease-prediction model runs as an independent deployment. Leave unset
# until it exists: /ready and /api/v1/ai/health then report `not_configured`
# instead of inventing model details.
# The deployed classifier is EfficientNetV2-S over the 38 PlantVillage classes.
# It exposes GET /health and POST /predict, where /predict takes multipart field
# `image` and returns `predicted_class`, `confidence` and `top_5_predictions`.
AI_SERVICE_URL=https://efficentnet-plant-disease-detection.onrender.com
# Generous on purpose: the Render free tier cold-starts in roughly 60 seconds
# after idling, and the previous 30s default timed out on that first request.
AI_SERVICE_TIMEOUT_MS=90000

# --- Pl@ntNet API Configuration ----------------------------------------------
# PLANTNET_API_KEY: Obtained from Pl@ntNet. Never commit real secrets.
PLANTNET_API_KEY=YOUR_REAL_KEY
PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all
PLANTNET_MIN_CONFIDENCE=0.50
PLANTNET_TIMEOUT_MS=20000

# --- ElevenLabs voice (read aloud + spoken questions) -------------------------
# Powers the speaker icon beside every block of text and the floating mic
# assistant. Optional: leave unset and /api/v1/voice/* answers 503 with a clear
# message, `configured: false` on /voice/status, and the clients hide the voice
# controls instead of offering buttons that fail.
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_API_URL=https://api.elevenlabs.io/v1

# Text-to-speech model. Flash 2.5 is the default: lowest latency (this drives a
# tap-to-listen button), cheapest per character, and one of only two models that
# honour `language_code` so pronunciation is pinned rather than guessed.
# Language coverage: it speaks en, hi and ta with the pin; te, kn and ml are not
# on its list, so the server drops the pin for those and lets the model read the
# script directly. That works, but set eleven_v3 if those three are the priority.
ELEVEN_LABS_TTS_MODEL=eleven_flash_v2_5

# Speech-to-text model used by the mic assistant. Scribe handles all six
# languages, including Telugu, Kannada and Malayalam.
ELEVEN_LABS_STT_MODEL=scribe_v1

# Default narrator: the premade "Sarah" voice, verified to work on the free
# tier. Careful when changing this — ElevenLabs classifies some premade voices
# (Rachel 21m00Tcm4TlvDq8ikWAM, Aria 9BWtsMINqrJLrRacOk9x) as *library* voices
# and answers 402 "paid_plan_required" for free accounts.
ELEVEN_LABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

ELEVEN_LABS_TIMEOUT_MS=30000

# Synthesis is billed per character, so a request carrying a whole article is a
# real cost. The clients trim before sending; this is the server-side backstop.
ELEVEN_LABS_MAX_CHARS=2500

# --- YOLO11x leaf detector (Stage 1) -----------------------------------------
# Leaf localization that runs BEFORE Pl@ntNet. It answers one question — is
# there a leaf in this frame — so a photo of a wall is rejected in ~1s instead
# of spending a Pl@ntNet identification call to reach the same answer.
#
# Optional. Leave unset and scans behave exactly as they did before this stage
# existed: /api/v1/ai/health reports `not_configured` and every image goes
# straight to identification.
#
# Endpoints used: GET /api/health and POST /api/predict. Note /api/predict takes
# multipart field `file` (NOT `image`, which is what the disease service uses)
# plus `conf` and `imgsz`, and returns `leaf_count` and a `predictions` array of
# xyxy boxes.
#
# /api/capture is deliberately NOT called: it writes an annotated frame plus one
# file per detected leaf, and was observed completing that work and then killing
# the container before responding.
YOLO_SERVICE_URL=https://yolo-leafobjdetection-production.up.railway.app

# YOLO11x is 56.9M parameters on CPU. A warm container answers in about 1s, but
# a cold one spends ~35s downloading weights from Hugging Face first, and its
# health endpoint returns 200 the whole time with model_status="loading".
YOLO_SERVICE_TIMEOUT_MS=45000

# Detections below this score are discarded. Matches the detector's own default.
YOLO_MIN_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=640

# Whether a confident "no leaf here" stops the scan. Set false to record the
# detection and report it without ever blocking — the safer setting if false
# negatives on unusual crops matter more than the saved Pl@ntNet quota.
YOLO_GATE_ENABLED=true
