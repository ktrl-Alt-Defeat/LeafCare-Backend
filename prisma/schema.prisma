// LeafCare Production Prisma Schema
// Mapped to PostgreSQL 16 schema (25 tables, 15 ENUMs, 75 indexes, 123 constraints)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUM TYPES (15 ENUMs)
// -----------------------------------------------------------------------------

enum user_role {
  farmer
  expert
  admin
}

enum crop_season {
  kharif
  rabi
  zaid
  perennial
}

enum water_requirement {
  low
  moderate
  intermediate
  high
}

enum sunlight_exposure {
  full_sun
  partial_shade
  full_shade
}

enum drainage_level {
  poor
  moderate
  good
}

enum crop_life_cycle {
  annual
  biennial
  perennial
}

enum labour_level {
  low
  medium
  high
}

enum nutrient_unit {
  kg_per_hectare
  g_per_plant
}

enum companion_relationship {
  beneficial
  neutral
  avoid
}

enum disease_severity {
  low
  moderate
  high
  severe
}

enum pathogen_type {
  fungal
  bacterial
  viral
  pest
  nutrient_deficiency
  abiotic
}

enum post_category {
  disease_help
  crop_advice
  fertilizer
  irrigation
  weather
  marketplace
  general
}

enum product_category {
  seeds
  fertilizers
  crop_protection
  tools
  equipment
}

enum order_status {
  pending
  confirmed
  packed
  shipped
  delivered
  cancelled
  refunded
}

enum notification_type {
  weather_alert
  disease_alert
  community_reply
  order_update
  system
}

// -----------------------------------------------------------------------------
// MODULE 02: AUTH & IDENTITY (2 Tables)
// -----------------------------------------------------------------------------

model languages {
  language_code                  String                           @id @db.VarChar(10)
  language_name                  String                           @db.VarChar(100)
  native_name                    String                           @db.VarChar(100)
  sort_order                     Int                              @default(0)
  is_active                      Boolean                          @default(true)
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  users                          users[]
  crop_translations              crop_translations[]
  disease_translations           disease_translations[]
  knowledge_category_translations knowledge_category_translations[]
  knowledge_article_translations  knowledge_article_translations[]

  @@map("languages")
}

model users {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @db.VarChar(100)
  email              String               @unique @db.VarChar(255)
  password_hash      String               @db.VarChar(255)
  role               user_role            @default(farmer)
  language_code      String               @default("en") @db.VarChar(10)
  phone              String?              @db.VarChar(20)
  district           String?              @db.VarChar(100)
  state              String?              @db.VarChar(100)
  latitude           Decimal?             @db.Decimal(9, 6)
  longitude          Decimal?             @db.Decimal(9, 6)
  farm_size_acres    Decimal?             @db.Decimal(8, 2)
  experience_years   Int?                 @db.SmallInt
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?            @db.Timestamptz(6)

  language           languages            @relation(fields: [language_code], references: [language_code])
  user_crops         user_crops[]
  prediction_history prediction_history[]
  posts              posts[]
  comments           comments[]
  likes              likes[]
  products           products[]
  orders             orders[]
  reviews            reviews[]
  notifications      notifications[]
  knowledge_articles knowledge_articles[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// MODULE 03: AGRONOMY (5 Tables)
// -----------------------------------------------------------------------------

model crops {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                      String                     @unique @db.VarChar(100)
  scientific_name           String?                    @db.VarChar(150)
  temperature_min_c         Decimal?                   @db.Decimal(4, 1)
  temperature_max_c         Decimal?                   @db.Decimal(4, 1)
  ph_min                    Decimal?                   @db.Decimal(3, 1)
  ph_max                    Decimal?                   @db.Decimal(3, 1)
  rainfall_min_mm           Int?
  rainfall_max_mm           Int?
  humidity_min_pct          Int?
  humidity_max_pct          Int?
  growing_duration_days_min Int?
  growing_duration_days_max Int?
  water_req                 water_requirement?
  sunlight                  sunlight_exposure?
  drainage                  drainage_level?
  life_cycle                crop_life_cycle?
  labour_req                labour_level?
  nutrient_unit             nutrient_unit?
  nitrogen_requirement      Decimal?                   @db.Decimal(6, 2)
  phosphorus_requirement    Decimal?                   @db.Decimal(6, 2)
  potassium_requirement     Decimal?                   @db.Decimal(6, 2)
  row_spacing_cm            Int?
  plant_spacing_cm          Int?
  sowing_depth_cm           Decimal?                   @db.Decimal(4, 1)
  icon_name                 String?                    @db.VarChar(50)
  image_url                 String?                    @db.VarChar(500)
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                   @default(now()) @db.Timestamptz(6)

  crop_translations         crop_translations[]
  crop_seasons              crop_seasons[]
  user_crops                user_crops[]
  companions_source         crop_companions[]          @relation("CompanionCrop")
  companions_target         crop_companions[]          @relation("TargetCompanion")
  crop_diseases             crop_diseases[]
  prediction_history        prediction_history[]
  posts                     posts[]
  knowledge_article_crops   knowledge_article_crops[]

  @@map("crops")
}

model crop_translations {
  crop_id           String    @db.Uuid
  language_code     String    @db.VarChar(10)
  crop_name         String    @db.VarChar(100)
  description       String?
  sowing_method     String?
  harvesting_guide  String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  crop              crops     @relation(fields: [crop_id], references: [id], onDelete: Cascade)
  language          languages @relation(fields: [language_code], references: [language_code], onDelete: Restrict)

  @@id([crop_id, language_code])
  @@map("crop_translations")
}

model crop_seasons {
  crop_id    String      @db.Uuid
  season     crop_season

  crop       crops       @relation(fields: [crop_id], references: [id], onDelete: Cascade)

  @@id([crop_id, season])
  @@map("crop_seasons")
}

model user_crops {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  crop_id    String   @db.Uuid
  is_primary Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  crop       crops    @relation(fields: [crop_id], references: [id], onDelete: Cascade)

  // A farmer selects a crop once; duplicates would double-count the dashboard.
  @@unique([user_id, crop_id])
  @@map("user_crops")
}

model crop_companions {
  crop_id           String                 @db.Uuid
  companion_crop_id String                 @db.Uuid
  relationship      companion_relationship @default(beneficial)

  crop              crops                  @relation("CompanionCrop", fields: [crop_id], references: [id], onDelete: Cascade)
  companion_crop    crops                  @relation("TargetCompanion", fields: [companion_crop_id], references: [id], onDelete: Cascade)

  @@id([crop_id, companion_crop_id])
  @@map("crop_companions")
}

// -----------------------------------------------------------------------------
// MODULE 04: PATHOLOGY (3 Tables)
// -----------------------------------------------------------------------------

model diseases {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                       String                       @unique @db.VarChar(100)
  scientific_name            String?                      @db.VarChar(150)
  severity                   disease_severity             @default(moderate)
  pathogen_type              pathogen_type                @default(fungal)
  contagious                 Boolean                      @default(true)
  icon_name                  String?                      @db.VarChar(50)
  image_url                  String?                      @db.VarChar(500)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)

  disease_translations       disease_translations[]
  crop_diseases              crop_diseases[]
  prediction_history         prediction_history[]
  knowledge_article_diseases knowledge_article_diseases[]

  @@map("diseases")
}

model disease_translations {
  disease_id         String    @db.Uuid
  language_code      String    @db.VarChar(10)
  disease_name       String    @db.VarChar(150)
  symptoms           String[]
  causes             String[]
  prevention         String[]
  organic_treatment  String[]
  chemical_treatment String[]
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)

  disease            diseases  @relation(fields: [disease_id], references: [id], onDelete: Cascade)
  language           languages @relation(fields: [language_code], references: [language_code], onDelete: Restrict)

  @@id([disease_id, language_code])
  @@map("disease_translations")
}

model crop_diseases {
  crop_id           String            @db.Uuid
  disease_id        String            @db.Uuid
  is_primary_host   Boolean           @default(true)
  severity_override disease_severity?

  crop              crops             @relation(fields: [crop_id], references: [id], onDelete: Cascade)
  disease           diseases          @relation(fields: [disease_id], references: [id], onDelete: Cascade)

  @@id([crop_id, disease_id])
  @@map("crop_diseases")
}

// -----------------------------------------------------------------------------
// MODULE 05: PREDICTIONS / AI LOGS (1 Table)
// -----------------------------------------------------------------------------

model prediction_history {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  crop_id         String?   @db.Uuid
  disease_id      String?   @db.Uuid
  is_healthy      Boolean   @default(false)
  uploaded_image  String    @db.VarChar(500)
  confidence      Decimal   @db.Decimal(5, 2)
  model_version   String    @default("v1.0") @db.VarChar(50)
  prediction_date DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  user            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  crop            crops?    @relation(fields: [crop_id], references: [id], onDelete: SetNull)
  disease         diseases? @relation(fields: [disease_id], references: [id], onDelete: SetNull)

  @@map("prediction_history")
}

// -----------------------------------------------------------------------------
// MODULE 06: COMMUNITY FORUM (3 Tables)
// -----------------------------------------------------------------------------

model posts {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String        @db.Uuid
  crop_id    String?       @db.Uuid
  category   post_category @default(general)
  title      String        @db.VarChar(200)
  content    String
  image_url  String?       @db.VarChar(500)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at DateTime?     @db.Timestamptz(6)

  user       users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  crop       crops?        @relation(fields: [crop_id], references: [id], onDelete: SetNull)
  comments   comments[]
  likes      likes[]

  @@map("posts")
}

model comments {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String    @db.Uuid
  user_id    String    @db.Uuid
  content    String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  post       posts     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("comments")
}

model likes {
  post_id String @db.Uuid
  user_id String @db.Uuid

  post    posts  @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user    users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([post_id, user_id])
  @@map("likes")
}

// -----------------------------------------------------------------------------
// MODULE 07: MARKETPLACE (4 Tables)
// -----------------------------------------------------------------------------

model products {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id     String           @db.Uuid
  category      product_category @default(fertilizers)
  name          String           @db.VarChar(150)
  description   String?
  price         Decimal          @db.Decimal(12, 2)
  currency_code String           @default("INR") @db.VarChar(3)
  unit          String           @db.VarChar(50)
  stock_quantity Int             @default(0)
  is_organic    Boolean          @default(false)
  image_url     String?          @db.VarChar(500)
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime?        @db.Timestamptz(6)

  seller        users            @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  order_items   order_items[]
  reviews       reviews[]

  @@map("products")
}

model orders {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_id         String       @db.Uuid
  total_price      Decimal      @db.Decimal(12, 2)
  currency_code    String       @default("INR") @db.VarChar(3)
  delivery_address String
  status           order_status @default(pending)
  ordered_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)

  buyer            users        @relation(fields: [buyer_id], references: [id], onDelete: Restrict)
  order_items      order_items[]

  @@map("orders")
}

model order_items {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id     String   @db.Uuid
  product_id   String   @db.Uuid
  product_name String   @db.VarChar(150)
  quantity     Int      @default(1)
  unit_price   Decimal  @db.Decimal(12, 2)

  order        orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product      products @relation(fields: [product_id], references: [id], onDelete: Restrict)

  // One line per product per order; raise quantity instead of duplicating.
  @@unique([order_id, product_id])
  @@map("order_items")
}

model reviews {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  user_id    String   @db.Uuid
  rating     Int      @db.SmallInt
  comment    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  product    products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // One review per buyer per product, otherwise ratings can be stuffed.
  @@unique([product_id, user_id])
  @@map("reviews")
}

// -----------------------------------------------------------------------------
// MODULE 08: NOTIFICATIONS (1 Table)
// -----------------------------------------------------------------------------

model notifications {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  type       notification_type
  title      String            @db.VarChar(150)
  message    String
  link_url   String?           @db.VarChar(500)
  read_at    DateTime?         @db.Timestamptz(6)
  is_read    Boolean           @default(false)
  created_at DateTime          @default(now()) @db.Timestamptz(6)

  user       users             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// -----------------------------------------------------------------------------
// MODULE 09: KNOWLEDGE BASE (6 Tables)
// -----------------------------------------------------------------------------

model knowledge_categories {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                            String                            @unique @db.VarChar(100)
  sort_order                      Int                               @default(0)
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)

  knowledge_category_translations knowledge_category_translations[]
  knowledge_articles              knowledge_articles[]

  @@map("knowledge_categories")
}

model knowledge_category_translations {
  category_id    String               @db.Uuid
  language_code  String               @db.VarChar(10)
  category_name  String               @db.VarChar(100)
  description    String?

  category       knowledge_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  language       languages            @relation(fields: [language_code], references: [language_code], onDelete: Restrict)

  @@id([category_id, language_code])
  @@map("knowledge_category_translations")
}

model knowledge_articles {
  id                             String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id                    String                           @db.Uuid
  author_id                      String?                          @db.Uuid
  slug                           String                           @unique @db.VarChar(150)
  hero_image_url                 String?                          @db.VarChar(500)
  published_at                   DateTime?                        @db.Timestamptz(6)
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                         @default(now()) @db.Timestamptz(6)

  category                       knowledge_categories             @relation(fields: [category_id], references: [id], onDelete: Restrict)
  author                         users?                           @relation(fields: [author_id], references: [id], onDelete: SetNull)
  knowledge_article_translations knowledge_article_translations[]
  knowledge_article_crops        knowledge_article_crops[]
  knowledge_article_diseases     knowledge_article_diseases[]

  @@map("knowledge_articles")
}

model knowledge_article_translations {
  article_id    String             @db.Uuid
  language_code String             @db.VarChar(10)
  title         String             @db.VarChar(200)
  summary       String?
  body          String
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @db.Timestamptz(6)

  article       knowledge_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  language      languages          @relation(fields: [language_code], references: [language_code], onDelete: Restrict)

  @@id([article_id, language_code])
  @@map("knowledge_article_translations")
}

model knowledge_article_crops {
  article_id String             @db.Uuid
  crop_id    String             @db.Uuid

  article    knowledge_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  crop       crops              @relation(fields: [crop_id], references: [id], onDelete: Cascade)

  @@id([article_id, crop_id])
  @@map("knowledge_article_crops")
}

model knowledge_article_diseases {
  article_id String             @db.Uuid
  disease_id String             @db.Uuid

  article    knowledge_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)
  disease    diseases           @relation(fields: [disease_id], references: [id], onDelete: Cascade)

  @@id([article_id, disease_id])
  @@map("knowledge_article_diseases")
}
