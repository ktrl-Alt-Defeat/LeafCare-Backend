# Keeps the build context small and, more importantly, keeps secrets and local
# state out of the image.

node_modules
dist

# Never bake real credentials into an image. The platform injects them.
.env
.env.local
.env.*.local

.git
.gitignore
.github

logs
*.log
npm-debug.log*

.vscode
.idea
.DS_Store

# Not needed at runtime.
docs
archive
scratch
tests
README.md
Dockerfile
.dockerignore
render.yaml
